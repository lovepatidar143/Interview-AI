# Copy this file to .env and fill in real values:  cp .env.example .env

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/interview-ai

# Secret used to sign JWTs - use a long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Google Gemini API key - get one at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
